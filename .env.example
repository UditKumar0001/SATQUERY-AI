# Router LLM API Key (Step 20) - Get from Google AI Studio
GEMINI_API_KEY=your-gemini-api-key-here

# Router LLM Model Name (Optional, defaults to gemini-3.6-flash)
GEMINI_ROUTER_MODEL=gemini-3.6-flash

# Database URL (Step 5)
DATABASE_URL=sqlite:///./satquery.db

# Device for model inference ('cuda' or 'cpu')
MODEL_DEVICE=cpu

# Hugging Face Access Token (Step 6, Steps 8-12, Step 39) - Get from https://huggingface.co/settings/tokens
HF_TOKEN=your-hf-token-here

# Backend API URL for Streamlit frontend (Step 31)
BACKEND_API_URL=http://localhost:8000
